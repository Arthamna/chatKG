# Works for local development; change this before exposing Neo4j outside localhost.
NEO4J_PASSWORD=local-development-password

# Required for automatic schema mapping, graph extraction, and Ask.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Maximum output tokens per request, including reasoning tokens.
OPENROUTER_MAX_TOKENS=4096
# Conservative shared free-tier request budget; adjust to your account limits.
OPENROUTER_RPM=20
OPENROUTER_RPD=50

# Optional legacy provider: set LLM_PROVIDER=groq to use it.
GROQ_API_KEY=
