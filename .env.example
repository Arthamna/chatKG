# Works for local development; change this before exposing Neo4j outside localhost.
NEO4J_PASSWORD=local-development-password

# Required for automatic schema mapping, graph extraction, and Ask.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MODELS=openrouter/free
OPENROUTER_RPM=20
OPENROUTER_RPD=50

# Maximum output tokens per request, including reasoning tokens.
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_INCOMPLETE_RETRIES=3

# Batching (very limited context on free model ) Messages per checkpoint
EPISODE_MAX_MESSAGES=20

INGEST_INCOMPLETE_RETRIES=5
INGEST_RETRY_BASE_SECONDS=2

# ANOTHER PROVIDER, set LLM_PROVIDER=groq to use it.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_SMALL_MODEL=
